{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    
    /* Configuración para Alias y Extensiones */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}